# Copy to .env and fill in. Everything but OPTCG_DOMAIN and OPTCG_SECRET is optional.

# The site's domain (Caddy gets its certificate) and its public URL (Google redirects back to it)
OPTCG_DOMAIN=optcg.example.com
OPTCG_PUBLIC_URL=https://optcg.example.com
# Signs session cookies. Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OPTCG_SECRET=

# House bots, ;-separated; the first is the default. Checkpoints go in models/ before building.
OPTCG_BOTS=greedy
# OPTCG_BOTS=mcts:models/house.pt;models/house.pt;greedy
# Decks to offer (;-separated names). Leave out for your lists in decks/ plus every official deck.
# OPTCG_DECKS=rocks;(Yellow) Charlotte Linlin
OPTCG_HOUSE_DECK=(Yellow) Charlotte Linlin

# Google sign-in (optional; guests can always play). Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID (Web application), redirect URI https://<domain>/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Card art on a CDN (optional; without it the table draws text cards). See docs/hosting.md.
# OPTCG_ART_BASE=https://dxxxxxxxx.cloudfront.net
# OPTCG_ART_MANIFEST=/app/models/art.json

# Limits
# OPTCG_MOVE_TIMEOUT=30
# OPTCG_BOT_MATCHES=2
# OPTCG_MAX_GAMES=500
# OPTCG_IDLE_MINUTES=30
